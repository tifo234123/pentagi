# Copy to `.env.workshop` (never commit `.env.workshop`) when running the isolated workshop stack.
# All ports, tenant IDs, and sandbox ranges are separated from a live PentAGI installation.

WORKSHOP_LISTEN_IP=127.0.0.1
WORKSHOP_LISTEN_PORT=8445
WORKSHOP_PGVECTOR_LISTEN_IP=127.0.0.1
WORKSHOP_PGVECTOR_LISTEN_PORT=5435
WORKSHOP_PGEXPORTER_LISTEN_IP=127.0.0.1
WORKSHOP_PGEXPORTER_LISTEN_PORT=9189
WORKSHOP_SCRAPER_LISTEN_IP=127.0.0.1
WORKSHOP_SCRAPER_LISTEN_PORT=9445

WORKSHOP_TENANT_ID=workshop
WORKSHOP_INSTALLATION_ID=pentagi-workshop-dev
WORKSHOP_COOKIE_SIGNING_SALT=replace-with-random-workshop-salt
WORKSHOP_DOCKER_PORTS_BASE=32000

PENTAGI_POSTGRES_USER=postgres
PENTAGI_POSTGRES_PASSWORD=workshop-dev-postgres-password
PENTAGI_POSTGRES_DB=pentagi_workshop

# T3-inspired multi-CLI bridge settings (used when adding -f docker-compose-cli-bridge.yml)
CLI_BRIDGE_API_KEY=replace-with-random-bridge-bearer-token
# Optional space-separated CLI npm packages to bake into the cli-bridge image on --build
# e.g. CLI_BRIDGE_NPM_PACKAGES="@anthropic-ai/claude-code @openai/codex @google/gemini-cli"
CLI_BRIDGE_NPM_PACKAGES=
# Explicitly allowlist one or more drivers: claude, codex, gemini, stdio-json
CLI_BRIDGE_ENABLED_DRIVERS=claude
CLI_BRIDGE_DEFAULT_DRIVER=claude
CLI_BRIDGE_DEFAULT_MODEL=claude/sonnet
CLI_BRIDGE_TIMEOUT_MS=120000
CLI_BRIDGE_MAX_CONCURRENT=8
# Optional: override bridge URL (e.g., http://host.docker.internal:8090/v1 to reach a host-running cli-bridge)
CLI_BRIDGE_URL=http://cli-bridge:8090/v1
# Optional provider API keys when running CLIs inside the cli-bridge container
CLI_BRIDGE_ANTHROPIC_API_KEY=
CLI_BRIDGE_OPENAI_API_KEY=
CLI_BRIDGE_GEMINI_API_KEY=
